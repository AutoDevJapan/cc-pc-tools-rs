diff --git a/codex-rs/tui/src/test_support.rs b/codex-rs/tui/src/test_support.rs
index a83764e..9c32d7f 100644
--- a/codex-rs/tui/src/test_support.rs
+++ b/codex-rs/tui/src/test_support.rs
@@ -70,3 +70,34 @@ macro_rules! boxed_future {
     };
 }
 pub(crate) use boxed_future;
+
+/// Stack size for tests whose async setup and embedded app-server startup do not fit in the
+/// 8 MiB `RUST_MIN_STACK` that the repository's test runners request on Windows debug builds.
+const LARGE_STACK_TEST_BYTES: usize = 32 * 1024 * 1024;
+
+/// Runs an async test body on a dedicated large-stack thread with its own current-thread runtime.
+///
+/// The future is created inside the new thread, so it does not need to be `Send`. Panics from
+/// the test body are re-raised on the calling test thread to keep the original failure message.
+pub(crate) fn run_on_large_stack<F, Fut, T>(make_future: F) -> T
+where
+    F: FnOnce() -> Fut + Send + 'static,
+    Fut: std::future::Future<Output = T>,
+    T: Send + 'static,
+{
+    let handle = std::thread::Builder::new()
+        .name("tui-large-stack-test".to_string())
+        .stack_size(LARGE_STACK_TEST_BYTES)
+        .spawn(move || {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+                .expect("test runtime");
+            runtime.block_on(make_future())
+        })
+        .expect("spawn large-stack test thread");
+    match handle.join() {
+        Ok(output) => output,
+        Err(panic) => std::panic::resume_unwind(panic),
+    }
+}
