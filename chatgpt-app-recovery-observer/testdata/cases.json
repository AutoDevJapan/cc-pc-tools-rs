{
  "warning": "Synthetic assumptions only; no native lifecycle proof and no live activation.",
  "limits": {
    "event_ttl_seconds": 300,
    "activation_attempts_per_incident": 1,
    "min_distinct_incident_gap_seconds": 600,
    "max_distinct_incidents_per_rolling_hour": 3,
    "max_preflight_rechecks": 2,
    "max_preflight_seconds": 180
  },
  "defaults": {
    "adapter": "fake_only",
    "process": "absent",
    "event": "synthetic_verified_exit",
    "fresh": true,
    "package_matches": true,
    "session_matches": true,
    "session_known": true,
    "instance_matches": true,
    "intent": "synthetic_no_stop_confirmed",
    "owner_stop": false,
    "directives_fresh": true,
    "log_epoch_matches": true,
    "time_trustworthy": true,
    "persist_success": true,
    "stop_generation_changed": false,
    "lock_acquired": true,
    "incidents_last_hour": 0
  },
  "cases": [
    {
      "id": "present",
      "given": {
        "process": "present"
      },
      "expected": {
        "decision": "retain",
        "fake_activation_calls": 0,
        "live_activation_calls": 0
      }
    },
    {
      "id": "process_unknown",
      "given": {
        "process": "unknown"
      },
      "expected": {
        "decision": "unknown",
        "fake_activation_calls": 0,
        "live_activation_calls": 0
      }
    },
    {
      "id": "absent_without_event",
      "given": {
        "event": "missing"
      },
      "expected": {
        "decision": "observe",
        "fake_activation_calls": 0,
        "live_activation_calls": 0
      }
    },
    {
      "id": "old_event",
      "given": {
        "fresh": false
      },
      "expected": {
        "decision": "expired",
        "fake_activation_calls": 0,
        "live_activation_calls": 0
      }
    },
    {
      "id": "consumed_event",
      "given": {
        "consumed": true
