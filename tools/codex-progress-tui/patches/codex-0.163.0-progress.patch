+//! Persistent, read-only progress for native agents and separately launched jobs.
+//!
+//! The Go collector emits a public-label projection of recorded measurements.
+//! Acquisition runs off the draw thread, uses a process-wide cache and an OS
+//! file lock, and retains the last readable snapshot after acquisition failure.
+//! No task state, model selection, account or service setting is changed here.
+
+use crate::render::renderable::Renderable;
+use crate::tui::FrameRequester;
+use chrono::DateTime;
+use chrono::Utc;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use serde::Deserialize;
+use std::collections::HashSet;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::time::Duration;
+use std::time::Instant;
+use unicode_width::UnicodeWidthChar;
+use unicode_width::UnicodeWidthStr;
+
+const REFRESH: Duration = Duration::from_secs(2);
+const SHARED_CACHE_FRESH: Duration = Duration::from_secs(4);
+const STALE_SECONDS: i64 = 12;
+const SNAPSHOT_BYTES: u64 = 8 * 1024 * 1024;
+const CACHE_ROOT: &str = "D:/CC/Work/parallel-agent-progress-runtime";
+const COLLECTOR: &str = "D:/CC/Tools/agent-progress/agent-progress.exe";
+
+#[derive(Clone, Default, Deserialize)]
+pub(crate) struct ProgressSnapshot {
+    schema_version: u32,
+    heartbeat_at: String,
+    status: String,
+    #[serde(default)]
+    tasks: Vec<ProgressTask>,
+    #[serde(default)]
+    jobs: Vec<ProgressJob>,
+    #[serde(default)]
+    truncated: bool,
+}
+
+#[derive(Clone, Default, Deserialize)]
+struct ProgressTask {
+    task_id: u64,
+    display_name: String,
+    recorded_status: String,
+    percent: Option<u8>,
+    execution: String,
+    phase: String,
+    #[serde(default)]
+    task_type: String,
+    #[serde(default)]
+    wait_reasons: Vec<ProgressWait>,
+    #[serde(default)]
+    last_activity: ProgressClock,
+}
+
+#[derive(Clone, Default, Deserialize)]
+struct ProgressJob {
+    #[serde(default)]
+    todo_ids: Vec<u64>,
+    public_label: String,
+    execution: String,
+    phase: String,
+    #[serde(default)]
+    recorded_status: String,
+    #[serde(default)]
+    worker_presence: String,
+    #[serde(default)]
+    wait_reasons: Vec<ProgressWait>,
+    #[serde(default)]
+    last_activity: ProgressClock,
+}
+
+#[derive(Clone, Default, Deserialize)]
+struct ProgressClock {
+    at: Option<String>,
+    state: String,
+}
+
+impl ProgressClock {
+    fn processing(&self) -> bool {
+        self.state == "fresh"
+            && self.at.as_deref().is_some_and(|at| {
+                DateTime::parse_from_rfc3339(at).is_ok_and(|at| {
+                    let age = Utc::now().signed_duration_since(at).num_milliseconds();
+                    (0..=30_000).contains(&age)
+                })
+            })
+    }
+}
+
+fn processing_phase(phase: &str) -> bool {
+    matches!(
+        phase,
+        "thinking" | "tool" | "editing" | "research" | "delegating"
+    )
+}
+
+pub(crate) fn native_processing(
+    status: Option<&codex_app_server_protocol::ThreadStatus>,
+    recent_processing: bool,
+    live: bool,
+) -> bool {
+    recent_processing
+        && live
+        && matches!(status, Some(codex_app_server_protocol::ThreadStatus::Active { active_flags }) if active_flags.is_empty())
+}
+
+#[derive(Clone, Default, Deserialize)]
+struct ProgressWait {
+    kind: String,
+    #[serde(default)]
+    todo_ids: Vec<u64>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct NativeProgress {
+    pub(crate) label: String,
+    pub(crate) running: bool,
+    pub(crate) closed: bool,
+}
+
+#[derive(Clone)]
+pub(crate) struct ProgressRow {
+    label: String,
+    percent: Option<u8>,
+    state: String,
+}
+
+#[derive(Default)]
+struct Cache {
+    snapshot: Option<Arc<ProgressSnapshot>>,
+    refreshing: bool,
+    attempted: Option<Instant>,
+    failed: bool,
+}
+
+static CACHE: OnceLock<Arc<Mutex<Cache>>> = OnceLock::new();
+
+#[derive(Default)]
+pub(crate) struct ParallelProgress {
+    enabled: bool,
+    native: Vec<NativeProgress>,
+    #[cfg(test)]
+    test_snapshot: Option<ProgressSnapshot>,
+}
+
+impl ParallelProgress {
+    pub(crate) fn from_environment() -> Self {
+        Self {
+            // Disabled unless the validated interactive launcher opts in.
+            enabled: std::env::var("CC_AGENT_PROGRESS").is_ok_and(|value| value == "1"),
+            native: Vec::new(),
+            #[cfg(test)]
+            test_snapshot: None,
+        }
+    }
+
+    pub(crate) fn set_native(&mut self, native: Vec<NativeProgress>) {
+        self.native = native;
+    }
+
+    pub(crate) fn tick(&self, frame: &FrameRequester) {
+        if !self.enabled {
+            return;
+        }
+        #[cfg(test)]
+        if self.test_snapshot.is_some() {
+            return;
+        }
+        frame.schedule_frame_in(REFRESH);
+        let cache = CACHE
+            .get_or_init(|| Arc::new(Mutex::new(Cache::default())))
+            .clone();
+        let refresh = cache.lock().ok().is_some_and(|mut state| {
+            if state.refreshing || state.attempted.is_some_and(|at| at.elapsed() < REFRESH) {
+                return false;
+            }
+            state.refreshing = true;
+            state.attempted = Some(Instant::now());
+            true
+        });
+        if refresh {
+            let frame = frame.clone();
+            tokio::task::spawn_blocking(move || {
+                let observed = acquire_snapshot();
+                if let Ok(mut state) = cache.lock() {
+                    match observed {
+                        Ok(snapshot) => {
+                            // Partial observations still contain newly verified
+                            // work. Only total unavailability retains a previous
+                            // generation unchanged.
+                            state.failed = snapshot.status == "unavailable";
+                            if snapshot.status != "unavailable" || state.snapshot.is_none() {
+                                state.snapshot = Some(Arc::new(snapshot));
+                            }
+                        }
+                        Err(_) => state.failed = true,
+                    }
+                    state.refreshing = false;
+                }
+                frame.schedule_frame();
+            });
+        }
+    }
+
+    pub(crate) fn panel(&self) -> Option<ProgressPanel> {
+        if !self.enabled {
+            return None;
+        }
+        #[cfg(test)]
+        if let Some(snapshot) = &self.test_snapshot {
+            return Some(ProgressPanel::new(Some(snapshot), &self.native, false));
+        }
+        let (snapshot, failed) = CACHE
+            .get()
+            .and_then(|cache| cache.lock().ok())
+            .map(|cache| (cache.snapshot.clone(), cache.failed))
+            .unwrap_or((None, false));
+        Some(ProgressPanel::new(
+            snapshot.as_deref(),
+            &self.native,
+            failed,
+        ))
+    }
+    #[cfg(test)]
+    pub(crate) fn ready_fixture() -> Self {
+        let snapshot: ProgressSnapshot = serde_json::from_value(serde_json::json!({
+            "schema_version":1,"heartbeat_at":Utc::now().to_rfc3339(),"status":"ok",
+            "tasks":[{"task_id":7,"display_name":"万世記","recorded_status":"doing","percent":70,
+                "execution":"running","phase":"tool","task_type":"check",
+                "last_activity":{"state":"fresh","at":Utc::now().to_rfc3339()}}],"jobs":[]
+        }))
+        .unwrap();
+        Self {
+            enabled: true,
+            native: Vec::new(),
+            test_snapshot: Some(snapshot),
+        }
+    }
+}
+
+fn read_snapshot(path: &Path) -> std::io::Result<ProgressSnapshot> {
+    let mut attempts = 0;
+    let file = loop {
+        match File::open(path) {
+            Ok(file) => break file,
+            Err(error)
+                if cfg!(windows)
+                    && matches!(error.raw_os_error(), Some(5 | 32))
+                    && attempts < 3 =>
+            {
+                attempts += 1;
+                std::thread::sleep(Duration::from_millis(40));
+            }
+            Err(error) => return Err(error),
+        }
+    };
+    let mut bytes = Vec::new();
+    file.take(SNAPSHOT_BYTES + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > SNAPSHOT_BYTES {
+        return Err(std::io::ErrorKind::InvalidData.into());
+    }
+    let parsed: ProgressSnapshot = serde_json::from_slice(&bytes)
+        .map_err(|_| std::io::Error::from(std::io::ErrorKind::InvalidData))?;
+    if parsed.schema_version != 1 || parsed.tasks.len() > 10_000 || parsed.jobs.len() > 10_000 {
+        return Err(std::io::ErrorKind::InvalidData.into());
+    }
+    Ok(parsed)
+}
+
+fn snapshot_recent(snapshot: &ProgressSnapshot) -> bool {
+    DateTime::parse_from_rfc3339(&snapshot.heartbeat_at).is_ok_and(|at| {
+        let age = Utc::now().signed_duration_since(at).num_milliseconds();
+        (0..SHARED_CACHE_FRESH.as_millis() as i64).contains(&age)
+    })
+}
+
+fn acquire_snapshot() -> std::io::Result<ProgressSnapshot> {
+    let root = PathBuf::from(CACHE_ROOT);
+    std::fs::create_dir_all(&root)?;
+    // Older TUI instances keep their diagnostic snapshot and lock unchanged.
+    let path = root.join("snapshot-active-v1.json");
+    if let Ok(snapshot) = read_snapshot(&path)
+        && snapshot_recent(&snapshot)
+    {
+        return Ok(snapshot);
+    }
+    let lock = OpenOptions::new()
+        .create(true)
+        .read(true)
+        .write(true)
+        .truncate(false)
+        .open(root.join("acquisition-active.lock"))?;
+    if lock.try_lock().is_err() {
+        // Another terminal owns collection. Reading the previous atomic file
+        // never certifies its freshness: the renderer shows its actual age.
+        return read_snapshot(&path);
+    }
+    if let Ok(snapshot) = read_snapshot(&path)
+        && snapshot_recent(&snapshot)
+    {
+        return Ok(snapshot);
+    }
+    let mut command = Command::new(COLLECTOR);
+    command
+        .args([
+            "--once",
+            "--active-only",
+            "--deadline",
+            "4s",
+            "--max-rows",
+            "1000",
+            "--output",
+        ])
+        .arg(&path)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    }
+    let mut child = command.spawn()?;
+    let deadline = Instant::now() + Duration::from_secs(6);
+    loop {
+        let observed = match child.try_wait() {
+            Ok(observed) => observed,
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(error);
+            }
+        };
+        match observed {
+            Some(status) => {
+                // Exit 1 intentionally publishes a degraded snapshot.
+                if !status.success() && status.code() != Some(1) {
+                    return Err(std::io::ErrorKind::Other.into());
+                }
+                return read_snapshot(&path);
+            }
+            None if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(50)),
+            None => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(std::io::ErrorKind::TimedOut.into());
+            }
+        }
+    }
+}
+
+fn safe_text(text: &str, width: usize) -> String {
+    let mut out = String::new();
+    let mut used = 0;
+    for ch in text.chars() {
+        if ch.is_control()
+            || matches!(ch, '\u{00ad}' | '\u{061c}' | '\u{200b}'..='\u{200f}' |
+            '\u{202a}'..='\u{202e}' | '\u{2060}'..='\u{206f}' | '\u{feff}')
+        {
+            continue;
+        }
+        let cells = ch.width().unwrap_or(0);
+        if used + cells > width {
+            break;
+        }
+        out.push(ch);
+        used += cells;
+    }
+    out
+}
+
+fn task_state(task: &ProgressTask) -> String {
+    if task.recorded_status == "done" {
+        return "完了".into();
+    }
+    if let Some(reason) = task.wait_reasons.first() {
+        return match reason.kind.as_str() {
+            "owner_decision" | "owner_reply" => "本人の回答待ち".into(),
+            "dependency" | "todo_dependency" => {
+                let ids = reason
+                    .todo_ids
+                    .iter()
+                    .take(2)
+                    .map(|id| format!("#{id}"))
+                    .collect::<Vec<_>>()
+                    .join("・");
+                if ids.is_empty() {
+                    "別の作業待ち".into()
+                } else {
+                    format!("別の作業待ち {ids}")
+                }
+            }
+            "model_capacity" | "provider_capacity" => "モデルの空き待ち".into(),
+            "quota" | "provider_quota" | "subscription_readiness" => "利用枠の回復待ち".into(),
+            "resource" | "resource_wait" | "execution_slot" => "実行枠の空き待ち".into(),
+            "other_worker" => "別の担当が作業中".into(),
+            "rate_limit" | "technical_retry" => "再試行待ち".into(),
+            "blocked_unspecified" | "unknown" => "待機理由を確認中".into(),
+            "recovery_unverified" => "元の作業記録を確認中".into(),
+            "owner_stop" => "本人の指示で停止中".into(),
+            _ => "待機中".into(),
+        };
+    }
+    let phase = if task.execution == "running" {
+        task.phase.as_str()
+    } else {
+        ""
+    };
+    match phase {
+        "testing" | "test" => "テスト中".into(),
+        "implementation" | "editing" | "file_change" => "実装中".into(),
+        "review" | "reviewing" => "レビュー中".into(),
+        "research" | "searching" => "調査中".into(),
+        "thinking" | "reasoning" => "考え中".into(),
+        "planning" => "手順を整理中".into(),
+        "summarizing" => "作業を引き継ぎ中".into(),
+        "reporting" => "結果を記録中".into(),
+        "delegating" => "担当へ依頼中".into(),
+        _ => match task.execution.as_str() {
+            "running" => match task.task_type.as_str() {
+                "check" | "test" | "testing" => "テスト中".into(),
+                "review" => "レビュー中".into(),
+                "research" => "調査中".into(),
+                "implementation" => "実装中".into(),
+                "ci_fix" => "テストを修正中".into(),
+                "cleanup" => "後片付け中".into(),
+                _ => "作業中".into(),
+            },
+            "queued" | "starting" => "起動待ち".into(),
+            "finished" => "続きの作業あり".into(),
+            "alive_identity_unknown" | "unknown" => "状態を確認中".into(),
+            _ if task.recorded_status == "wait" => "別の作業待ち".into(),
+            _ if task.recorded_status == "block" => "待機理由を確認中".into(),
+            _ => "待機中".into(),
+        },
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct ProgressPanel {
+    rows: Vec<ProgressRow>,
+    header: String,
+    warning: Option<String>,
+}
+
+impl ProgressPanel {
+    fn new(snapshot: Option<&ProgressSnapshot>, native: &[NativeProgress], failed: bool) -> Self {
+        let mut rows = Vec::new();
+        for agent in native
+            .iter()
+            .filter(|agent| agent.running && !agent.closed)
+            .take(1_000)
+        {
+            rows.push(ProgressRow {
+                label: format!("この会話 {}", safe_text(&agent.label, 36)),
+                percent: None,
+                state: "作業中".into(),
+            });
+        }
+        let current = snapshot.is_some_and(|snapshot| {
+            !failed
+                && snapshot.status != "unavailable"
+                && DateTime::parse_from_rfc3339(&snapshot.heartbeat_at).is_ok_and(|at| {
+                    let age = Utc::now().signed_duration_since(at).num_milliseconds();
+                    (0..=STALE_SECONDS * 1_000).contains(&age)
+                })
+        });
+        let mut warning = if current {
+            None
+        } else {
+            Some("共有担当の現在の稼働を確認できません".into())
+        };
+        if let Some(snapshot) = snapshot.filter(|_| current) {
+            let mut displayed_tasks = HashSet::new();
+            let mut excluded_tasks = HashSet::new();
+            for task in &snapshot.tasks {
+                if !matches!(task.recorded_status.as_str(), "todo" | "doing")
+                    || task.execution != "running"
+                    || !task.wait_reasons.is_empty()
+                    || !processing_phase(&task.phase)
+                    || !task.last_activity.processing()
+                {
+                    excluded_tasks.insert(task.task_id);
+                    continue;
+                }
+                displayed_tasks.insert(task.task_id);
+                rows.push(ProgressRow {
+                    label: if task.display_name.trim().is_empty() {
+                        format!("作業 #{}", task.task_id)
+                    } else {
+                        safe_text(&task.display_name, 70)
+                    },
+                    percent: task.percent.filter(|percent| *percent <= 100),
+                    state: task_state(task),
+                });
+            }
+            for job in &snapshot.jobs {
+                if job
+                    .todo_ids
+                    .iter()
+                    .any(|id| displayed_tasks.contains(id) || excluded_tasks.contains(id))
+                    || job.recorded_status != "running"
+                    || job.execution != "running"
+                    || job.worker_presence != "verified_alive"
+                    || !job.wait_reasons.is_empty()
+                    || !processing_phase(&job.phase)
+                    || !job.last_activity.processing()
+                {
+                    continue;
+                }
+                rows.push(ProgressRow {
+                    label: format!("担当 {}", safe_text(&job.public_label, 50)),
+                    percent: None,
+                    state: if job.phase == "thinking" {
+                        "考え中"
+                    } else {
+                        "作業中"
+                    }
+                    .into(),
+                });
+            }
+            if snapshot.status != "ok" {
+                warning = Some("一部の状態を取得できません".into());
+            }
+            if snapshot.truncated {
+                warning = Some("表示件数の上限あり".into());
+            }
+        }
+        let header = if rows.is_empty() {
+            if current
+                && snapshot.is_some_and(|snapshot| snapshot.status == "ok" && !snapshot.truncated)
+            {
+                "並列担当  作業中なし".into()
+            } else {
+                "並列担当  稼働の確認待ち".into()
+            }
+        } else {
+            format!("並列担当  作業中 {}", rows.len())
+        };
+        Self {
+            rows,
+            header,
+            warning,
+        }
+    }
+    fn lines(&self, width: u16, height: u16) -> Vec<Line<'static>> {
+        if width == 0 || height == 0 {
+            return Vec::new();
+        }
+        let mut lines = vec![
+            Line::from(safe_text(&self.header, width as usize))
+                .cyan()
+                .bold(),
+        ];
+        if let Some(warning) = &self.warning
+            && height > 1
+        {
+            lines.push(Line::from(safe_text(warning, width as usize)).light_red());
+        }
+        let mut shown = 0;
+        if width < 24 {
+            return lines;
+        }
+        let wide = width >= 78;
+        for row in &self.rows {
+            let row_height = if wide {
+                1
+            } else if width >= 62 {
+                2
+            } else {
+                3
+            };
+            if lines.len() + row_height + 1 > height as usize {
+                break;
+            }
+            let bar_cells = if wide {
+                12
+            } else {
+                usize::from(width).saturating_sub(26).clamp(4, 12)
+            };
+            let (bar, percent) = if let Some(percent) = row.percent {
+                let fill = bar_cells * usize::from(percent) / 100;
+                (
+                    format!("{}{}", "█".repeat(fill), "░".repeat(bar_cells - fill)),
+                    format!("{percent:3}%"),
+                )
+            } else {
+                ("·".repeat(bar_cells), "未計測".into())
+            };
+            let status = safe_text(&row.state, if wide { 24 } else { 30 });
+            let meter = vec![
+                Span::from(bar.clone()).fg(Color::Green),
+                " ".into(),
+                percent.clone().dim(),
+                "  ".into(),
+                status.into(),
+            ];
+            if wide {
+                let label_width = usize::from(width).saturating_sub(48);
+                let label = safe_text(&row.label, label_width);
+                let padding = label_width.saturating_sub(label.width());
+                let mut spans = vec![format!("{label}{}  ", " ".repeat(padding)).into()];
+                spans.extend(meter);
+                lines.push(Line::from(spans));
+            } else {
+                lines.push(Line::from(safe_text(&row.label, usize::from(width))));
+                if width >= 62 {
+                    lines.push(Line::from(meter));
+                } else {
+                    lines.push(Line::from(vec![
+                        Span::from(bar).green(),
+                        " ".into(),
+                        percent.dim(),
+                    ]));
+                    lines.push(Line::from(safe_text(&row.state, usize::from(width))));
+                }
+            }
+            shown += 1;
+        }
+        if shown < self.rows.len() && lines.len() < height as usize {
+            lines.push(
+                Line::from(safe_text(
+                    &format!("ほか {} 件  /progress で一覧", self.rows.len() - shown),
+                    width as usize,
+                ))
+                .dim(),
+            );
+        }
+        lines
+    }
+
+    pub(crate) fn selection(&self) -> crate::bottom_pane::SelectionViewParams {
+        let mut items: Vec<crate::bottom_pane::SelectionItem> = self
+            .rows
+            .iter()
+            .map(|row| crate::bottom_pane::SelectionItem {
+                name: row.label.clone(),
+                description: Some(format!(
+                    "{}  {}",
+                    row.percent
+                        .map(|p| format!("{p}%"))
+                        .unwrap_or_else(|| "未計測".into()),
+                    row.state
+                )),
+                dismiss_on_select: false,
+                ..Default::default()
+            })
+            .collect();
+        if items.is_empty() {
+            items.push(crate::bottom_pane::SelectionItem {
+                name: self.header.clone(),
+                is_disabled: true,
+                ..Default::default()
+            });
+        }
+        crate::bottom_pane::SelectionViewParams {
+            title: Some("並列担当の進捗".into()),
+            subtitle: Some("一覧を開いた時点の状態。常設欄は自動更新します。".into()),
+            footer_note: self
+                .warning
+                .as_ref()
+                .map(|text| Line::from(text.clone()).light_red()),
+            items,
+            is_searchable: true,
+            search_placeholder: Some("担当・作業を絞り込む".into()),
+            max_visible_rows: 15,
+            view_id: Some("parallel-progress"),
+            ..Default::default()
+        }
+    }
+}
+
+impl Renderable for ProgressPanel {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        Paragraph::new(self.lines(area.width, area.height)).render(area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        if width < 24 {
+            return 1 + u16::from(self.warning.is_some());
+        }
+        let row_height = if width >= 78 {
+            1
+        } else if width >= 62 {
+            2
+        } else {
+            3
+        };
+        (1 + u16::from(self.warning.is_some()) + (self.rows.len().min(5) as u16) * row_height + 1)
+            .min(12)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn previous_phase_does_not_claim_running_for_finished_unknown_or_queued_work() {
+        for execution in ["finished", "unknown", "alive_identity_unknown", "queued"] {
+            let task = ProgressTask {
+                phase: "testing".into(),
+                execution: execution.into(),
+                ..Default::default()
+            };
+            assert_ne!(task_state(&task), "テスト中");
+        }
+        let task = ProgressTask {
+            phase: "testing".into(),
+            execution: "running".into(),
+            ..Default::default()
+        };
+        assert_eq!(task_state(&task), "テスト中");
+    }
+
+    #[test]
+    fn measured_progress_is_preserved_unknown_is_not_zero_and_test_copy_is_natural() {
+        let task = ProgressTask {
+            task_id: 7,
+            display_name: "万世記".into(),
+            recorded_status: "doing".into(),
+            percent: Some(70),
+            execution: "running".into(),
+            phase: "tool".into(),
+            task_type: "check".into(),
+            last_activity: ProgressClock {
+                at: Some(Utc::now().to_rfc3339()),
+                state: "fresh".into(),
+            },
+            ..Default::default()
+        };
+        let snapshot = ProgressSnapshot {
+            schema_version: 1,
+            heartbeat_at: Utc::now().to_rfc3339(),
+            status: "ok".into(),
+            tasks: vec![
+                task.clone(),
+                ProgressTask {
+                    task_id: 8,
+                    percent: None,
+                    ..task
+                },
+            ],
+            ..Default::default()
+        };
+        let panel = ProgressPanel::new(Some(&snapshot), &[], false);
+        let text = panel
+            .lines(100, 12)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(text.contains("70%"));
+        assert!(text.contains("未計測"));
+        assert!(text.contains("テスト中"));
+        assert!(!text.contains("検査中"));
+    }
+
+    #[test]
+    fn stale_or_failed_snapshot_hides_external_rows_and_keeps_only_active_native_agents() {
+        let snapshot = ProgressSnapshot {
+            heartbeat_at: (Utc::now() - chrono::Duration::seconds(40)).to_rfc3339(),
+            status: "ok".into(),
+            tasks: vec![ProgressTask {
+                task_id: 3,
+                display_name: "PCの道具".into(),
+                percent: Some(50),
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let native = [NativeProgress {
+            label: "Aquinas".into(),
+            running: true,
+            closed: false,
+        }];
+        let panel = ProgressPanel::new(Some(&snapshot), &native, true);
+        assert_eq!(panel.rows.len(), 1);
+        assert!(panel.header.contains("作業中 1"));
+        assert!(panel.warning.as_deref().unwrap().contains("確認できません"));
+    }
+
+    #[test]
+    fn terminal_controls_and_bidi_are_not_rendered_and_small_dimensions_are_bounded() {
+        assert_eq!(safe_text("万\u{001b}\u{202e}世記", 6), "万世記");
+        let panel = ProgressPanel {
+            header: "並列担当".into(),
+            warning: None,
+            rows: vec![ProgressRow {
+                label: "万世記のとても長い作業名".into(),
+                percent: Some(50),
+                state: "テスト中".into(),
+            }],
+        };
+        for width in [0, 1, 12, 40, 78, 120] {
+            for height in [0, 1, 3, 8] {
+                let area = Rect::new(0, 0, width, height);
+                let mut buffer = Buffer::empty(area);
+                panel.render(area, &mut buffer);
+                assert!(panel.lines(width, height).len() <= usize::from(height));
+            }
+        }
+    }
+
+    #[test]
+    fn parallel_progress_filters_waits_reports_unknown_and_expired_work() {
+        let now = Utc::now().to_rfc3339();
+        let active = serde_json::json!({
+            "task_id":1,"display_name":"PCの道具","recorded_status":"doing",
+            "percent":37,"execution":"running","phase":"tool",
+            "last_activity":{"at":now,"state":"fresh"}
+        });
+        let mut tasks = vec![active.clone()];
+        for (key, value) in [
+            ("recorded_status", serde_json::json!("wait")),
+            ("recorded_status", serde_json::json!("block")),
+            ("recorded_status", serde_json::json!("done")),
+            ("execution", serde_json::json!("lost")),
+            ("execution", serde_json::json!("unknown")),
+            ("phase", serde_json::json!("reporting")),
+            ("phase", serde_json::json!("unknown")),
+            ("wait_reasons", serde_json::json!([{"kind":"resource"}])),
+            (
+                "last_activity",
+                serde_json::json!({"state":"fresh","at":(Utc::now()-chrono::Duration::seconds(31)).to_rfc3339()}),
+            ),
+        ] {
+            let mut task = active.clone();
+            task["task_id"] = serde_json::json!(tasks.len() + 1);
+            task[key] = value;
+            tasks.push(task);
+        }
+        let job = serde_json::json!({"public_label":"PCの道具","execution":"running",
+            "recorded_status":"running","worker_presence":"verified_alive","phase":"tool",
+            "last_activity":{"at":now,"state":"fresh"}});
+        let mut duplicate = job.clone();
+        duplicate["todo_ids"] = serde_json::json!([1]);
+        let mut waiting = job.clone();
+        waiting["todo_ids"] = serde_json::json!([2]);
+        let snapshot: ProgressSnapshot = serde_json::from_value(serde_json::json!({
+            "schema_version":1,"heartbeat_at":now,"status":"ok","tasks":tasks,
+            "jobs":[job,duplicate,waiting]
+        }))
+        .unwrap();
+        let native = [
+            NativeProgress {
+                label: "active".into(),
+                running: true,
+                closed: false,
+            },
+            NativeProgress {
+                label: "idle".into(),
+                running: false,
+                closed: false,
+            },
+            NativeProgress {
+                label: "closed".into(),
+                running: true,
+                closed: true,
+            },
+        ];
+        let panel = ProgressPanel::new(Some(&snapshot), &native, false);
+        assert_eq!(panel.rows.len(), 3);
+        assert_eq!(panel.rows[1].percent, Some(37));
+        for failed in [false, true] {
+            let old = ProgressSnapshot {
+                heartbeat_at: (Utc::now() - chrono::Duration::seconds(13)).to_rfc3339(),
+                ..snapshot.clone()
+            };
+            assert!(ProgressPanel::new(Some(&old), &[], failed).rows.is_empty());
+        }
+        assert!(
+            ProgressPanel::new(Some(&snapshot), &[], true)
+                .rows
+                .is_empty()
+        );
+        let empty = ProgressSnapshot {
+            tasks: vec![],
+            jobs: vec![],
+            ..snapshot
+        };
+        assert!(
+            ProgressPanel::new(Some(&empty), &[], false)
+                .header
+                .contains("作業中なし")
+        );
+        let panel = ProgressPanel::new(Some(&empty), &[], false);
+        let selection = panel.selection();
+        assert_eq!(selection.items.len(), 1);
+        assert!(selection.items[0].is_disabled);
+        assert!(selection.items[0].name.contains("作業中なし"));
+        let partial = ProgressSnapshot {
+            status: "degraded".into(),
+            ..empty
+        };
+        let panel = ProgressPanel::new(Some(&partial), &[], false);
+        assert!(!panel.header.contains("作業中なし"));
+        assert!(panel.selection().items[0].name.contains("確認待ち"));
+    }
+
+    #[test]
+    fn parallel_progress_native_requires_live_processing_and_no_approval_or_input_wait() {
+        use codex_app_server_protocol::ThreadActiveFlag;
+        use codex_app_server_protocol::ThreadStatus;
+        let active = ThreadStatus::Active {
+            active_flags: vec![],
+        };
+        assert!(native_processing(Some(&active), true, true));
+        assert!(!native_processing(Some(&active), false, true));
+        assert!(!native_processing(Some(&active), true, false));
+        assert!(!native_processing(None, true, true));
+        for status in [
+            ThreadStatus::Idle,
+            ThreadStatus::NotLoaded,
+            ThreadStatus::SystemError,
+            ThreadStatus::Active {
+                active_flags: vec![ThreadActiveFlag::WaitingOnApproval],
+            },
+            ThreadStatus::Active {
+                active_flags: vec![ThreadActiveFlag::WaitingOnUserInput],
+            },
+        ] {
+            assert!(!native_processing(Some(&status), true, true));
+        }
+    }
+}
