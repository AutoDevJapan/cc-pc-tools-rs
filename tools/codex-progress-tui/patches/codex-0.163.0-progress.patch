+impl AgentsOverviewActivity {
+    fn observe_processing(&mut self, notification: &ServerNotification) {
+        match notification {
+            ServerNotification::ReasoningSummaryTextDelta(_)
+            | ServerNotification::ReasoningTextDelta(_)
+            | ServerNotification::CommandExecutionOutputDelta(_)
+            | ServerNotification::FileChangeOutputDelta(_) => {
+                self.processing_at = Some(std::time::Instant::now());
+            }
+            ServerNotification::ItemStarted(event) => {
+                self.processing_at = processing_item(&event.item).then(std::time::Instant::now);
+            }
+            ServerNotification::ItemCompleted(event) => {
+                self.processing_at = processing_item(&event.item).then(std::time::Instant::now);
+            }
+            ServerNotification::TurnStarted(_) | ServerNotification::TurnCompleted(_) => {
+                self.processing_at = None;
+            }
+            ServerNotification::ThreadStatusChanged(event) if !matches!(&event.status, ThreadStatus::Active { active_flags } if active_flags.is_empty()) =>
+            {
+                self.processing_at = None;
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) fn processing(&self) -> bool {
+        self.processing_at
+            .is_some_and(|at| at.elapsed() <= std::time::Duration::from_secs(30))
+    }
+}
+
+fn processing_item(item: &ThreadItem) -> bool {
