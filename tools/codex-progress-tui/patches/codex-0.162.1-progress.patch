+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn previous_phase_does_not_claim_running_for_finished_unknown_or_queued_work() {
+        for execution in ["finished", "unknown", "alive_identity_unknown", "queued"] {
+            let task = ProgressTask {
+                phase: "testing".into(),
+                execution: execution.into(),
+                ..Default::default()
+            };
+            assert_ne!(task_state(&task), "テスト中");
+        }
+        let task = ProgressTask {
+            phase: "testing".into(),
+            execution: "running".into(),
+            ..Default::default()
+        };
+        assert_eq!(task_state(&task), "テスト中");
+    }
+
+    #[test]
+    fn measured_progress_is_preserved_unknown_is_not_zero_and_test_copy_is_natural() {
+        let task = ProgressTask {
+            task_id: 7,
+            display_name: "万世記".into(),
+            recorded_status: "doing".into(),
+            percent: Some(70),
+            execution: "running".into(),
+            phase: "tool".into(),
+            task_type: "check".into(),
+            last_activity: ProgressClock {
+                at: Some(Utc::now().to_rfc3339()),
+                state: "fresh".into(),
+            },
+            ..Default::default()
+        };
+        let snapshot = ProgressSnapshot {
+            schema_version: 1,
+            heartbeat_at: Utc::now().to_rfc3339(),
+            status: "ok".into(),
+            tasks: vec![
+                task.clone(),
+                ProgressTask {
+                    task_id: 8,
+                    percent: None,
+                    ..task
+                },
+            ],
+            ..Default::default()
+        };
+        let panel = ProgressPanel::new(Some(&snapshot), &[], false);
+        let text = panel
+            .lines(100, 12)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(text.contains("70%"));
+        assert!(text.contains("未計測"));
+        assert!(text.contains("テスト中"));
+        assert!(!text.contains("検査中"));
+    }
+
+    #[test]
+    fn stale_or_failed_snapshot_hides_external_rows_and_keeps_only_active_native_agents() {
+        let snapshot = ProgressSnapshot {
+            heartbeat_at: (Utc::now() - chrono::Duration::seconds(40)).to_rfc3339(),
+            status: "ok".into(),
+            tasks: vec![ProgressTask {
+                task_id: 3,
+                display_name: "PCの道具".into(),
+                percent: Some(50),
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let native = [NativeProgress {
+            label: "Aquinas".into(),
+            running: true,
+            closed: false,
+        }];
+        let panel = ProgressPanel::new(Some(&snapshot), &native, true);
+        assert_eq!(panel.rows.len(), 1);
+        assert!(panel.header.contains("作業中 1"));
+        assert!(panel.warning.as_deref().unwrap().contains("確認できません"));
+    }
+
+    #[test]
+    fn terminal_controls_and_bidi_are_not_rendered_and_small_dimensions_are_bounded() {
+        assert_eq!(safe_text("万\u{001b}\u{202e}世記", 6), "万世記");
+        let panel = ProgressPanel {
+            header: "並列担当".into(),
+            warning: None,
+            rows: vec![ProgressRow {
+                label: "万世記のとても長い作業名".into(),
+                percent: Some(50),
+                state: "テスト中".into(),
+            }],
+        };
+        for width in [0, 1, 12, 40, 78, 120] {
+            for height in [0, 1, 3, 8] {
+                let area = Rect::new(0, 0, width, height);
+                let mut buffer = Buffer::empty(area);
+                panel.render(area, &mut buffer);
+                assert!(panel.lines(width, height).len() <= usize::from(height));
+            }
+        }
+    }
+
+    #[test]
+    fn parallel_progress_filters_waits_reports_unknown_and_expired_work() {
+        let now = Utc::now().to_rfc3339();
+        let active = serde_json::json!({
+            "task_id":1,"display_name":"PCの道具","recorded_status":"doing",
+            "percent":37,"execution":"running","phase":"tool",
+            "last_activity":{"at":now,"state":"fresh"}
+        });
+        let mut tasks = vec![active.clone()];
+        for (key, value) in [
+            ("recorded_status", serde_json::json!("wait")),
+            ("recorded_status", serde_json::json!("block")),
+            ("recorded_status", serde_json::json!("done")),
+            ("execution", serde_json::json!("lost")),
+            ("execution", serde_json::json!("unknown")),
+            ("phase", serde_json::json!("reporting")),
+            ("phase", serde_json::json!("unknown")),
+            ("wait_reasons", serde_json::json!([{"kind":"resource"}])),
+            (
+                "last_activity",
+                serde_json::json!({"state":"fresh","at":(Utc::now()-chrono::Duration::seconds(31)).to_rfc3339()}),
+            ),
+        ] {
+            let mut task = active.clone();
+            task["task_id"] = serde_json::json!(tasks.len() + 1);
+            task[key] = value;
+            tasks.push(task);
+        }
+        let job = serde_json::json!({"public_label":"PCの道具","execution":"running",
+            "recorded_status":"running","worker_presence":"verified_alive","phase":"tool",
+            "last_activity":{"at":now,"state":"fresh"}});
+        let mut duplicate = job.clone();
+        duplicate["todo_ids"] = serde_json::json!([1]);
+        let mut waiting = job.clone();
+        waiting["todo_ids"] = serde_json::json!([2]);
+        let snapshot: ProgressSnapshot = serde_json::from_value(serde_json::json!({
+            "schema_version":1,"heartbeat_at":now,"status":"ok","tasks":tasks,
+            "jobs":[job,duplicate,waiting]
+        }))
+        .unwrap();
+        let native = [
+            NativeProgress {
+                label: "active".into(),
+                running: true,
+                closed: false,
+            },
+            NativeProgress {
+                label: "idle".into(),
+                running: false,
+                closed: false,
+            },
+            NativeProgress {
+                label: "closed".into(),
+                running: true,
+                closed: true,
+            },
+        ];
+        let panel = ProgressPanel::new(Some(&snapshot), &native, false);
+        assert_eq!(panel.rows.len(), 3);
+        assert_eq!(panel.rows[1].percent, Some(37));
+        for failed in [false, true] {
+            let old = ProgressSnapshot {
+                heartbeat_at: (Utc::now() - chrono::Duration::seconds(13)).to_rfc3339(),
+                ..snapshot.clone()
+            };
+            assert!(ProgressPanel::new(Some(&old), &[], failed).rows.is_empty());
+        }
+        assert!(
+            ProgressPanel::new(Some(&snapshot), &[], true)
+                .rows
+                .is_empty()
+        );
+        let empty = ProgressSnapshot {
+            tasks: vec![],
+            jobs: vec![],
+            ..snapshot
+        };
+        assert!(
+            ProgressPanel::new(Some(&empty), &[], false)
+                .header
+                .contains("作業中なし")
+        );
+    }
+
+    #[test]
+    fn parallel_progress_native_requires_live_processing_and_no_approval_or_input_wait() {
+        use codex_app_server_protocol::ThreadActiveFlag;
+        use codex_app_server_protocol::ThreadStatus;
+        let active = ThreadStatus::Active {
+            active_flags: vec![],
+        };
+        assert!(native_processing(Some(&active), true, true));
+        assert!(!native_processing(Some(&active), false, true));
+        assert!(!native_processing(Some(&active), true, false));
+        assert!(!native_processing(None, true, true));
+        for status in [
+            ThreadStatus::Idle,
+            ThreadStatus::NotLoaded,
+            ThreadStatus::SystemError,
+            ThreadStatus::Active {
+                active_flags: vec![ThreadActiveFlag::WaitingOnApproval],
+            },
+            ThreadStatus::Active {
+                active_flags: vec![ThreadActiveFlag::WaitingOnUserInput],
+            },
+        ] {
+            assert!(!native_processing(Some(&status), true, true));
+        }
+    }
+}
