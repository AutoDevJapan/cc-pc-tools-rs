+            {
+                self.processing_at = None;
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) fn processing(&self) -> bool {
+        self.processing_at
+            .is_some_and(|at| at.elapsed() <= std::time::Duration::from_secs(30))
